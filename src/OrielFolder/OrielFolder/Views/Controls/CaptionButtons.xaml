<UserControl
    x:Class="OrielFolder.Views.Controls.CaptionButtons"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    VerticalAlignment="Stretch">

    <!-- Own caption buttons (no extended title-bar mode, see Helpers/CustomWindowFrame.cs). Clicks, snap layouts and
         keyboard behaviour come from the system through InputNonClientPointerSource regions; these Borders only draw.
         Borders instead of Buttons: a Button template ignores a code-set Background while the pointer is non-client. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
        <Border x:Name="MinimizeButton" Width="46" Background="Transparent"
                AutomationProperties.Name="Minimize" AutomationProperties.AutomationId="Caption_Minimize">
            <FontIcon x:Name="MinimizeGlyph" Glyph="&#xE921;" FontSize="10"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}" IsHitTestVisible="False"/>
        </Border>
        <Border x:Name="MaximizeButton" Width="46" Background="Transparent"
                AutomationProperties.Name="Maximize" AutomationProperties.AutomationId="Caption_Maximize">
            <FontIcon x:Name="MaximizeGlyph" Glyph="&#xE922;" FontSize="10"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}" IsHitTestVisible="False"/>
        </Border>
        <Border x:Name="CloseButton" Width="46" Background="Transparent"
                AutomationProperties.Name="Close" AutomationProperties.AutomationId="Caption_Close">
            <FontIcon x:Name="CloseGlyph" Glyph="&#xE8BB;" FontSize="10"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}" IsHitTestVisible="False"/>
        </Border>
    </StackPanel>
</UserControl>
