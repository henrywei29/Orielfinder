<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OrielFolder.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <!-- Outer grid: matte graphite background fills rounded corners -->
    <Grid Background="#202124">
        <!-- Inner border: clips WebView2 with rounded corners -->
        <Border CornerRadius="12" Margin="0" Background="#202124">
            <controls:WebView2 x:Name="WebContent"
                               DefaultBackgroundColor="#202124" />
        </Border>
    </Grid>
</Window>
