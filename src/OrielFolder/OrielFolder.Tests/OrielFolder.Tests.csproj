  <!-- Issue #66 — 네이티브 엔진 테스트용. DllImportSearchPath.AssemblyDirectory로 찾으므로
       테스트 어셈블리 옆에 있어야 한다. x64 전용이며, 다른 플랫폼에서는 엔진 테스트가
       "사용 불가"를 확인하는 경로로 자동 전환된다. -->
  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <Content Include="..\..\..\third_party\otterzip\x64\otterzip_ffi.dll">
      <Link>otterzip_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**\*">
