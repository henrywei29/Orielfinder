<UserControl
    x:Class="Span.Views.DetailsModeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Span.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 헤더 버튼: 텍스트 좌측정렬 강제 -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{ThemeResource SpanTextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Tapped="OnRootTapped" RightTapped="OnEmptyAreaRightTapped" Background="{ThemeResource SpanContentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Row -->
        <Grid Grid.Row="0" Height="24"
              x:Name="HeaderGrid" SizeChanged="OnHeaderSizeChanged" AutomationProperties.AutomationId="Details_Header"
              Background="{ThemeResource SpanBgLayer2Brush}"
              BorderBrush="{ThemeResource SpanBorderSubtleBrush}"
              BorderThickness="0,0,0,1"
              RightTapped="OnHeaderRightTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NameColumnDef" Width="*" MinWidth="140"/>
                <ColumnDefinition x:Name="CloudStatusColumnDef" Width="72" MinWidth="40"/>
                <ColumnDefinition x:Name="ColorTagColumnDef" Width="130" MinWidth="60"/>
                <ColumnDefinition x:Name="LocationColumnDef" Width="0" MinWidth="0"/>
                <ColumnDefinition x:Name="DateColumnDef" Width="200" MinWidth="80"/>
                <ColumnDefinition x:Name="TypeColumnDef" Width="150" MinWidth="50"/>
                <ColumnDefinition x:Name="SizeColumnDef" Width="100" MinWidth="50"/>
                <ColumnDefinition x:Name="GitColumnDef" Width="50" MinWidth="40"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" x:Name="NameHeaderContainer">
                <Button x:Name="NameHeaderButton" Content="Name" Tag="Name" Padding="11,0,6,0"
                        Click="OnHeaderClick" Style="{StaticResource HeaderButtonStyle}"/>
            </Grid>
            <Grid Grid.Column="1" x:Name="CloudStatusHeaderContainer">
                <Button x:Name="CloudStatusHeaderButton" Content="Status" Tag="CloudStatus"
                        Click="OnHeaderClick" Style="{StaticResource HeaderButtonStyle}"/>
            </Grid>
            <Grid Grid.Column="2" x:Name="ColorTagHeaderContainer">
                <Button x:Name="ColorTagHeaderButton" Content="Color tag" Tag="ColorTag"
                        Click="OnHeaderClick" Style="{StaticResource HeaderButtonStyle}"/>
            </Grid>
            <Grid Grid.Column="3" x:Name="LocationHeaderContainer" Visibility="Collapsed">
                <Button x:Name="LocationHeaderButton" Content="Location" Tag="Location"
                        Click="OnHeaderClick" Style="{StaticResource HeaderButtonStyle}"/>
            </Grid>
            <Grid Grid.Column="4" x:Name="DateHeaderContainer">
                <Button x:Name="DateHeaderButton" Content="Date Modified" Tag="DateModified"
                        Click="OnHeaderClick" Style="{StaticResource HeaderButtonStyle}"/>
            </Grid>
            <Grid Grid.Column="5" x:Name="TypeHeaderContainer">
                <Button x:Name="TypeHeaderButton" Content="Type" Tag="Type"
                        Click="OnHeaderClick" Style="{StaticResource HeaderButtonStyle}"/>
            </Grid>
            <Grid Grid.Column="6" x:Name="SizeHeaderContainer">
                <Button x:Name="SizeHeaderButton" Content="Size" Tag="Size"
                        Click="OnHeaderClick" Style="{StaticResource HeaderButtonStyle}"/>
            </Grid>
            <Grid Grid.Column="7" x:Name="GitHeaderContainer">
                <Button x:Name="GitHeaderButton" Content="Git" Tag="Git"
                        Click="OnHeaderClick" Style="{StaticResource HeaderButtonStyle}"/>
            </Grid>
        </Grid>

        <!-- Items List -->
        <Grid Grid.Row="1" x:Name="ListViewWrapper"
              Loaded="OnListViewWrapperLoaded" Unloaded="OnListViewWrapperUnloaded">
        <ListView x:Name="DetailsListView" AutomationProperties.AutomationId="Details_ListView"
                  ItemsSource="{Binding CurrentItems, Mode=OneWay}"
                  SelectedItem="{Binding CurrentFolder.SelectedChild, Mode=TwoWay}"
                  SelectionMode="Extended"
                  CanDragItems="True"
                  AllowDrop="True"
                  DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted"
                  DragOver="OnListViewDragOver"
                  Drop="OnListViewDrop"
                  DragLeave="OnListViewDragLeave"
                  DoubleTapped="OnItemDoubleClick"
                  SelectionChanged="OnDetailsSelectionChanged"
                  ContainerContentChanging="OnContainerContentChanging"
                  Background="Transparent"
                  Padding="0">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="6,4,6,2" Background="{ThemeResource SpanBgLayer2Brush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Key}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource SpanTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Count}"
                                           FontSize="10"
                                           Foreground="{ThemeResource SpanTextTertiaryBrush}"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
                <StaticResource ResourceKey="DetailsItemStyle"/>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileSystemViewModel">
                    <Grid Height="28" RightTapped="OnItemRightTapped"
                          ToolTipService.ToolTip="{x:Bind TooltipText}"
                          Opacity="{x:Bind ItemOpacity, Mode=OneWay}">
                        
                        <!-- Stable cell identities allow headers and recycled rows to share the same order. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
<Border Tag="ItemColorMarker" Width="3" Height="14" CornerRadius="1.5"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"
                                Canvas.ZIndex="10" IsHitTestVisible="False"
                                Opacity="{x:Bind vm:FileSystemViewModel.OpacityIfTrue(HasTag), Mode=OneWay}"
                                Background="{x:Bind TagBrush, Mode=OneWay}"/>
                        <Border Tag="Name">
                        <Grid Margin="{x:Bind TreeIndent, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Width="20" Height="22" MinWidth="0" MinHeight="0" Padding="0"
                                Background="Transparent" BorderThickness="0" IsTabStop="False" AllowFocusOnInteraction="False"
                                Visibility="{x:Bind TreeExpanderVisibility, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind TreeActionLabel, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind TreeActionLabel, Mode=OneWay}"
                                Click="OnTreeExpanderClick" DoubleTapped="OnTreeExpanderDoubleTapped">
                            <FontIcon Glyph="{x:Bind TreeChevron, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource SpanTextSecondaryBrush}"/>
                        </Button>
                        <!-- Icon / Thumbnail / Custom Folder Icon -->
                        <Grid Grid.Column="1" Width="{Binding IconFontSize, Source={StaticResource FontScale}}" Height="{Binding IconFontSize, Source={StaticResource FontScale}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{x:Bind ThumbnailSource, Mode=OneWay}" Stretch="UniformToFill"
                                   Visibility="{x:Bind vm:FileSystemViewModel.ShowIfTrue(HasThumbnail), Mode=OneWay}"/>
                            <Image Source="{x:Bind CustomIcon, Mode=OneWay}" Stretch="Uniform"
                                   Visibility="{x:Bind CustomIconVisibility, Mode=OneWay}"/>
                            <FontIcon FontFamily="{StaticResource RemixIcons}"
                                      Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                      Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                      FontSize="{Binding IconFontSize, Source={StaticResource FontScale}}"
                                      Visibility="{x:Bind vm:FileSystemViewModel.ShowIfFalseAndFalse(HasThumbnail, HasCustomIcon), Mode=OneWay}"/>
                            <!-- Issue #58: folder colour tag (top-left, overlay - no layout impact) -->
                            <Border Visibility="{x:Bind vm:FileSystemViewModel.ShowIfTrue(ShowTagDot), Mode=OneWay}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0"
                                    Width="9" Height="9" CornerRadius="4.5"
                                    Background="{x:Bind TagBrush, Mode=OneWay}"
                                    IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Name (display) -->
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind TruncatedDisplayName, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{Binding ItemFontSize, Source={StaticResource FontScale}}"
                                   Padding="6,0"
                                   Visibility="{x:Bind vm:FileSystemViewModel.NotRenaming(IsRenaming), Mode=OneWay}"/>
                        <!-- Rename TextBox (visible during rename) -->
                        <TextBox Grid.Column="2"
                                 Text="{x:Bind EditableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{x:Bind IsRenaming, Mode=OneWay}"
                                 Margin="0" VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0" MinHeight="0" FontSize="{Binding ItemFontSize, Source={StaticResource FontScale}}"
                                 LostFocus="OnRenameTextBoxLostFocus"
                                 KeyDown="OnRenameTextBoxKeyDown"/>

                        </Grid>
                        </Border>
                        <Border Grid.Column="1" Tag="CloudStatus" Width="72">
                        <FontIcon x:Phase="1" Glyph="{x:Bind CloudStateGlyph, Mode=OneWay}"
                                  Foreground="{x:Bind CloudBadgeBrush, Mode=OneWay}" FontSize="12"
                                  HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="{x:Bind CloudStatusText, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind CloudStatusText, Mode=OneWay}"/>
                        </Border>

                        <Border Grid.Column="2" Tag="ColorTag" Width="130">
                            <Grid x:Phase="1" Padding="6,0" VerticalAlignment="Center"
                                  Visibility="{x:Bind vm:FileSystemViewModel.ShowIfTrue(HasTag), Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="9" Height="9" CornerRadius="4.5" Margin="0,0,6,0" Opacity="0" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind TagText, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind TagText, Mode=OneWay}"
                                           FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"/>
                            </Grid>
                        </Border>

                        <!-- Location (검색 결과에서만 표시) -->
                        <Border Grid.Column="3" Tag="Location" x:Name="LocationCell" Width="0">
                            <TextBlock x:Phase="1" Text="{x:Bind LocationPath, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Foreground="{ThemeResource SpanTextSecondaryBrush}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Date Modified -->
                        <Border Grid.Column="4" Tag="DateModified" x:Name="DateCell" Width="200">
                            <TextBlock x:Phase="1" Text="{x:Bind DateModified, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>
                        <!-- Type -->
                        <Border Grid.Column="5" Tag="Type" x:Name="TypeCell" Width="150">
                            <TextBlock x:Phase="1" Text="{x:Bind FileType, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Size -->
                        <Border Grid.Column="6" Tag="Size" x:Name="SizeCell" Width="100">
                            <TextBlock x:Phase="1" Text="{x:Bind Size, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       Padding="6,0"/>
                        </Border>

                        <!-- Git Status -->
                        <Border Grid.Column="7" Tag="Git" x:Name="GitCell" Width="50">
                            <TextBlock x:Phase="1" Text="{x:Bind GitStatusText, Mode=OneWay}"
                                       Foreground="{x:Bind GitStatusBrush, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{Binding SecondaryFontSize, Source={StaticResource FontScale}}"
                                       FontWeight="Bold"
                                       Padding="6,0"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </Grid>
    </Grid>
</UserControl>
